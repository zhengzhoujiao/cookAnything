# Copy to backend/.env. Never commit the resulting file.
# Run `python scripts/init_local_env.py` from the repository root to generate
# independent local credentials without printing them.
MONGODB_URL=mongodb://localhost:27019
DATABASE_NAME=electronic_recipe
API_PATH_PREFIX=/wte-api
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Required: independently generated random secret, at least 32 characters.
SECRET_KEY=
# Required: at least 12 characters, at most 72 UTF-8 bytes.
# Only used to create the administrator in a new database.
ADMIN_INITIAL_PASSWORD=
