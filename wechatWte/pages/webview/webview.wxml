<!--pages/webview/webview.wxml-->

<!-- 加载失败时的错误兜底 UI -->
<view class="error-wrap" wx:if="{{loadError}}">
  <text class="error-emoji">🍽️</text>
  <text class="error-title">页面加载失败</text>
  <text class="error-msg">{{errorMsg}}</text>
  <button class="retry-btn" bindtap="onRetry">重新加载</button>
</view>

<!-- 正常状态：WebView 占满全部内容区域 -->
<web-view
  wx:else
  src="{{webviewUrl}}"
  bindload="handleLoad"
  binderror="handleError"
  bindmessage="handleMessage"
></web-view>
