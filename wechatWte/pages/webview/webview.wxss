/* pages/webview/webview.wxss */

/* 确保 web-view 撑满整个内容区域 */
page {
  height: 100%;
}

/* ===== 加载失败兜底 UI ===== */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 80rpx;
  box-sizing: border-box;
  background: #f9fafb;
}

.error-emoji {
  font-size: 128rpx;
  margin-bottom: 48rpx;
  line-height: 1;
}

.error-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.error-msg {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 72rpx;
}

.retry-btn {
  background: #1f2937;
  color: #ffffff;
  border-radius: 100rpx;
  font-size: 30rpx;
  padding: 0 80rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}
